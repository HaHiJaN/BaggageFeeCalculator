<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/baggage_background">

    <!-- About Page Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarAbout"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/baggage_primary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <!-- Scrollable About Page Content -->
    <ScrollView
        android:id="@+id/scrollAbout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- App Name -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/baggage_text_primary"
                android:gravity="center"
                android:layout_marginTop="24dp" />

            <!-- App Description -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calculate your excess baggage charges easily."
                android:textSize="14sp"
                android:textColor="@color/baggage_text_secondary"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="32dp" />

            <!-- Developer Information Heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Developer Information"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/baggage_text_primary"
                android:layout_marginBottom="16dp" />

            <!-- Student Name Label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Student Name"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/baggage_text_secondary" />

            <!-- Student Name Value -->
            <TextView
                android:id="@+id/tvStudentName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NAJIHAH BINTI HISHAM"
                android:textSize="16sp"
                android:textColor="@color/baggage_text_primary"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp" />

            <!-- Student Number Label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Student Matric Number"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/baggage_text_secondary" />

            <!-- Student Number Value -->
            <TextView
                android:id="@+id/tvStudentNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2024274902"
                android:textSize="16sp"
                android:textColor="@color/baggage_text_primary"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp" />

            <!-- Group Label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Group"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/baggage_text_secondary"/>

            <!-- Group Value -->
            <TextView
                android:id="@+id/tvGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RCDCS2405B"
                android:textSize="16sp"
                android:textColor="@color/baggage_text_primary"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp" />

            <!-- Programme Code Label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Programme Code"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/baggage_text_secondary" />

            <!-- Programme Code Value -->
            <TextView
                android:id="@+id/tvProgrammeCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CDCS240"
                android:textSize="16sp"
                android:textColor="@color/baggage_text_primary"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="32dp" />

            <!-- GitHub Project Heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GitHub Project"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/baggage_text_primary"
                android:layout_marginBottom="12dp" />

            <!-- GitHub Link -->
            <TextView
                android:id="@+id/tvGithubLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="View Project on GitHub"
                android:textSize="16sp"
                android:textColor="@color/baggage_link"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginBottom="32dp" />

            <!-- Copyright -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="© 2026 Baggage Fee Calculator. All rights reserved."
                android:textSize="12sp"
                android:textColor="@color/baggage_text_secondary"
                android:gravity="center"
                android:layout_marginBottom="24dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
